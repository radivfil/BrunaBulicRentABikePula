---
/**
 * Korijen stranice. Na statičnom hostingu nema servera koji bi čitao
 * Accept-Language, pa preusmjeravanje radi kratka skripta — ali stranica
 * je i bez JS-a potpuno upotrebljiva: ispod je popis jezika kao obični
 * linkovi, koje tražilica vidi i slijedi.
 *
 * noindex je namjeran: ovo je razdjelnik, a ne sadržaj. Indeksiraju se
 * /hr/, /en/, /de/ i /it/, međusobno povezani hreflangom.
 */
import { LOCALE_META, SITE_URL } from '../data/site.mjs';
import { locales, defaultLocale, path } from '../i18n/routes';
import { withBase } from '../lib/url';
---

<!doctype html>
<html lang="hr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Rent a Bike Pula — najam bicikala Pula i Istra</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={new URL(path(defaultLocale), SITE_URL).href} />
    {locales.map((l) => (
      <link rel="alternate" hreflang={LOCALE_META[l].htmlLang} href={new URL(path(l), SITE_URL).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(path(defaultLocale), SITE_URL).href} />
    <style is:inline>
      body { margin:0; display:grid; place-items:center; min-height:100svh;
             font:400 1rem/1.5 system-ui,sans-serif; background:#faf8f3; color:#1a1c17; }
      ul { list-style:none; display:flex; gap:.5rem; padding:0; flex-wrap:wrap; justify-content:center }
      a { display:block; padding:.75rem 1.25rem; border:1px solid #d8cfbb; border-radius:.5rem;
          text-decoration:none; color:#3f4a2e; font-weight:600 }
    </style>
    <script is:inline define:vars={{ base: withBase("/") }}>
      (function () {
        var supported = ['hr', 'en', 'de', 'it'];
        var langs = navigator.languages || [navigator.language || 'hr'];
        var pick = 'hr';
        for (var i = 0; i < langs.length; i++) {
          var code = String(langs[i]).slice(0, 2).toLowerCase();
          if (supported.indexOf(code) !== -1) { pick = code; break; }
        }
        location.replace(base + pick + '/');
      })();
    </script>
  </head>
  <body>
    <nav>
      <p style="text-align:center;margin-bottom:1rem">Rent a Bike Pula</p>
      <ul>
        {locales.map((l) => <li><a href={path(l)}>{LOCALE_META[l].label}</a></li>)}
      </ul>
    </nav>
  </body>
</html>
