---
import { path, type Locale, type RouteKey } from '../../i18n/routes';
import { useT } from '../../i18n/ui';

interface Props { lang: Locale; title: string; lead?: string; routeKey: RouteKey }
const { lang, title, lead, routeKey } = Astro.props;
const t = useT(lang);
---

<header class="u-grain border-b border-limestone-200 bg-limestone-100">
  <div class="u-container py-14 sm:py-20">
    <nav aria-label="Breadcrumb" class="text-xs text-ink-muted">
      <a href={path(lang)} class="underline-offset-4 hover:underline hover:text-terracotta-600">Rent a Bike Pula</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <span aria-current="page">{title}</span>
    </nav>

    <h1 class="u-h2 mt-4 max-w-3xl font-display font-semibold">{title}</h1>
    {lead && <p class="u-lead mt-4 max-w-2xl text-ink-soft">{lead}</p>}
    <slot />
  </div>
</header>
