---
import PageHeader from './PageHeader.astro';
import CtaBand from '../site/CtaBand.astro';
import { TERMS } from '../../data/terms';
import type { Locale } from '../../i18n/routes';
import { useT } from '../../i18n/ui';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useT(lang);
const doc = TERMS[lang];
---

<PageHeader lang={lang} routeKey="terms" title={t('terms.title')} lead={doc.intro} />

<div class="u-container grid gap-12 py-16 lg:grid-cols-3">
  <div class="lg:col-span-2">
    <ol class="space-y-8">
      {doc.sections.map((s, i) => (
        <li class="u-reveal border-t border-limestone-200 pt-6">
          <h2 class="flex gap-3 font-display text-lg font-semibold text-olive-900">
            <span class="text-terracotta-600 tabular-nums">{String(i + 1).padStart(2, '0')}</span>
            {s.heading}
          </h2>
          <p class="mt-2 pl-9 leading-relaxed text-ink-soft">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>

  <aside class="lg:col-span-1">
    <div class="sticky top-[calc(var(--header-h)+1.5rem)] rounded-md border border-limestone-200 bg-limestone-100 p-6">
      <h2 class="font-display text-lg font-semibold text-olive-900">{doc.cancellationHeading}</h2>
      <ul class="mt-4 space-y-3 text-sm leading-relaxed text-ink-soft">
        {doc.cancellation.map((c) => (
          <li class="flex gap-2.5">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-terracotta-600" aria-hidden="true"></span>
            {c}
          </li>
        ))}
      </ul>
      <p class="mt-6 border-t border-limestone-200 pt-4 text-xs text-ink-muted">
        Radna verzija teksta — prije objave na provjeru pravnoj osobi i usklađivanje s postojećim uvjetima.
      </p>
    </div>
  </aside>
</div>

<CtaBand lang={lang} />
