---
import { BUSINESS } from '../../data/site.mjs';
import { path, type Locale, type RouteKey } from '../../i18n/routes';
import { useT } from '../../i18n/ui';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useT(lang);

const explore: Array<[RouteKey, string]> = [
  ['bikes', t('nav.bikes')],
  ['tours', t('nav.tours')],
  ['prices', t('nav.prices')],
  ['equipment', t('nav.equipment')],
  ['about', t('nav.about')],
  ['terms', t('terms.title')],
];

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${BUSINESS.geo.lat},${BUSINESS.geo.lng}`;
---

<footer class="mt-24 bg-olive-900 text-limestone-200">
  <div class="u-container grid gap-10 py-16 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-display text-xl font-semibold text-limestone-50">Rent a Bike Pula</p>
      <address class="mt-4 space-y-1 text-sm not-italic leading-relaxed text-limestone-300">
        <p>{BUSINESS.legalName}</p>
        <p>{BUSINESS.street}, {BUSINESS.district}</p>
        <p>{BUSINESS.postalCode} {BUSINESS.city}, {BUSINESS.countryName}</p>
      </address>
      <a href={mapsUrl} rel="noopener" target="_blank" class="mt-3 inline-block text-sm font-medium text-terracotta-400 underline-offset-4 hover:underline">
        {t('contact.directions')}
      </a>
    </div>

    <div>
      <h2 class="text-xs font-semibold tracking-[0.16em] text-limestone-50 uppercase">{t('footer.explore')}</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {explore.map(([key, label]) => (
          <li>
            <a href={path(lang, key)} class="text-limestone-300 underline-offset-4 transition-colors hover:text-limestone-50 hover:underline">
              {label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="text-xs font-semibold tracking-[0.16em] text-limestone-50 uppercase">{t('footer.hours')}</h2>
      <dl class="mt-4 space-y-2 text-sm text-limestone-300">
        <div class="flex justify-between gap-4"><dt>{t('contact.hours.weekdays')}</dt><dd>8:30 – 20:00</dd></div>
        <div class="flex justify-between gap-4"><dt>{t('contact.hours.saturday')}</dt><dd>9:00 – 14:00</dd></div>
        <div class="flex justify-between gap-4"><dt>{t('contact.hours.sunday')}</dt><dd>{t('contact.closed')}</dd></div>
      </dl>
      <a href={`tel:${BUSINESS.phoneHref}`} class="mt-5 block font-display text-xl font-semibold text-limestone-50 hover:text-terracotta-400">
        {BUSINESS.phone}
      </a>
      <a href={`mailto:${BUSINESS.email}`} class="mt-1 block text-sm text-limestone-300 underline-offset-4 hover:underline">
        {BUSINESS.email}
      </a>
    </div>

    <div>
      <h2 class="text-xs font-semibold tracking-[0.16em] text-limestone-50 uppercase">{t('footer.follow')}</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={BUSINESS.social.facebook} rel="noopener" target="_blank" class="text-limestone-300 underline-offset-4 hover:text-limestone-50 hover:underline">Facebook</a></li>
        <li><a href={BUSINESS.social.tripadvisor} rel="noopener" target="_blank" class="text-limestone-300 underline-offset-4 hover:text-limestone-50 hover:underline">TripAdvisor</a></li>
        <li><a href={BUSINESS.social.parent} rel="noopener" target="_blank" class="text-limestone-300 underline-offset-4 hover:text-limestone-50 hover:underline">brbsport.hr</a></li>
      </ul>
      <a
        href={`https://wa.me/${BUSINESS.whatsapp}`}
        rel="noopener"
        target="_blank"
        class="mt-5 inline-flex items-center gap-2 rounded-sm bg-olive-700 px-4 py-2.5 text-sm font-semibold text-limestone-50 transition-colors hover:bg-terracotta-600"
      >
        {t('contact.whatsapp')}
      </a>
    </div>
  </div>

  <div class="border-t border-olive-700/60">
    <div class="u-container flex flex-col gap-2 py-6 text-xs text-limestone-300 sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} {BUSINESS.legalName}. {t('footer.rights')}</p>
      <p>OIB · TODO — {BUSINESS.contactPerson}: {BUSINESS.phone}</p>
    </div>
  </div>
</footer>
