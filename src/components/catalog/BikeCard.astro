---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { path, type Locale } from '../../i18n/routes';
import { useT } from '../../i18n/ui';

interface Props { bike: CollectionEntry<'bikes'>; lang: Locale; eager?: boolean }
const { bike, lang, eager = false } = Astro.props;

const t = useT(lang);
const d = bike.data;
const copy = d.i18n[lang]!;
const href = path(lang, 'bikes', bike.id);
---

<article
  class="group u-reveal relative flex flex-col overflow-hidden rounded-md border border-limestone-200 bg-limestone-100 transition-[transform,box-shadow] duration-300 ease-[var(--ease-out-quint)] hover:-translate-y-1 hover:shadow-lift"
  data-category={d.category}
  data-price={d.pricing.d1}
  data-sizes={d.specs.sizes.join(',')}
  data-order={d.order}
>
  <div class="relative aspect-[4/3] overflow-hidden bg-limestone-100">
    <Image
      src={d.image}
      alt={d.imageAlt[lang]!}
      widths={[280, 420, 640]}
      sizes="(min-width: 1024px) 22rem, (min-width: 640px) 45vw, 90vw"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      class:list={[
        'h-full w-full transition-transform duration-500 ease-[var(--ease-out-quint)] group-hover:scale-[1.04]',
        d.imageStyle === 'photo' ? 'object-cover' : 'cutout object-contain p-5',
      ]}
      style={`view-transition-name: bike-${bike.id}`}
    />
    <span class="absolute left-3 top-3 rounded-xs bg-olive-900/85 px-2 py-1 text-[0.6875rem] font-semibold tracking-wide text-limestone-100 uppercase">
      {t(`cat.${d.category}` as never)}
    </span>
  </div>

  <div class="flex flex-1 flex-col gap-1 border-t border-limestone-200 bg-limestone-50 p-5">
    <h3 class="u-h3 font-display text-lg leading-tight font-semibold">
      {/* Cijela kartica je klikabilna preko ::after, ali link ostaje na
          naslovu — čitač ekrana tako dobiva smislen tekst veze. */}
      <a href={href} class="after:absolute after:inset-0 after:content-['']">{copy.name}</a>
    </h3>
    <p class="text-sm text-ink-muted">{copy.tagline}</p>

    <div class="mt-auto flex items-end justify-between gap-3 pt-4">
      <p class="flex items-baseline gap-1">
        <span class="text-xs text-ink-muted">{t('catalog.from')}</span>
        <span class="font-display text-2xl leading-none font-semibold text-olive-900">
          {d.pricing.d14} €
        </span>
        <span class="text-xs text-ink-muted">{t('catalog.perDay')}</span>
      </p>
      <p class="text-right text-xs text-ink-muted">
        {d.fleetSize} {t('catalog.inFleet')}
      </p>
    </div>
  </div>
</article>
