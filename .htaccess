# ─────────────────────────────────────────────────────────────
# Rent a Bike Pula — Apache konfiguracija
# Generirano; ne uređivati ručno bez usklađivanja s i18n/routes.ts
# ─────────────────────────────────────────────────────────────

Options -Indexes
DirectoryIndex index.html

<IfModule mod_headers.c>
  # Slike i fontovi imaju hash u imenu — smiju se keširati godinu dana.
  <FilesMatch "\.(avif|webp|jpg|jpeg|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML se mijenja pri svakom deployu — uvijek provjeri kod servera.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

ErrorDocument 404 /404.html

# ── 301: stare .php rute ──────────────────────────────────────

